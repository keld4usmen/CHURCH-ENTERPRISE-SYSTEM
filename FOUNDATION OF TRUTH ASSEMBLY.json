              "value": [
                {
                  "title": "Sunday Worship Service",
                  "date": "Every Sunday at 8:00 AM & 10:30 AM",
                  "description": "Join us for worship, teaching, and community.",
                  "location": "Sanctuary"
                },
                {
                  "title": "Wisdom Word Service (Mid-Week)",
                  "date": "Every Wednesday at 6:30 PM",
                  "description": "A time to learn and ask questions as we study the Word. Join in person or online via YouTube @FOTA TV.",
                  "location": "Church Sanctuary / YouTube @FOTA TV"
                },
                {
                  "title": "Free Medical Outreach",
                  "date": "Every Friday at 10:00 AM",
                  "description": "Free medical check-ups, prescriptions, and medical attention at our church clinic. Open to everyone. Support by contributing financially or volunteering as medical personnel.",
                  "location": "Church Clinic"
                },
                {
                  "title": "Child Dedication Service",
                  "date": "Last Sunday of Every Month",
                  "description": "We dedicate children to the Lord. Fill out the FOTA Child Dedication form on our mobile app to register. Our Ceremonies Pastor will respond promptly.",
                  "location": "Sanctuary"
                },
                {
                  "title": "The Art of Love - Couples Event",
                  "date": "Saturday, April 25th, 2026 at 2:00 PM",
                  "description": "FOTA Family Life invites couples (newlyweds or longtime partners) to reconnect, laugh, and grow stronger together. Invest in your relationship!",
